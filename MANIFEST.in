include README.md
include DEVELOPER_GUIDE.md
include LICENSE
include docs/conf.py
include docs/Makefile
recursive-include docs *.md
recursive-include docs *.ipynb
recursive-include docs/_static *.css *.png
recursive-include tests *.py
prune src/mftt.egg-info
prune docs/_build
prune docs/.jupyter_cache
global-exclude *.egg-info/*
exclude src/mftt.egg-info/SOURCES.txt
